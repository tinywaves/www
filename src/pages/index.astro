---
const navigation = [
  { label: 'Home', href: '#' },
  { label: 'Projects', href: '#' },
  { label: 'Blogs', href: '#' },
  { label: 'About', href: '#' },
];

const socialLinks = [
  { label: 'GitHub', href: '#' },
  { label: 'Email', href: '#' },
  { label: 'twitter', href: '#' },
  { label: 'WeChat', href: '#' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <title>Lyle Zheng</title>
  </head>
  <body>
    <main>
      <h1>Lyle Zheng</h1>

      <nav aria-label="Primary navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="social-links" aria-label="Social links">
        {socialLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>

      <footer>© tinywaves</footer>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Lato';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/lato-400.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Lato';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/lato-700.woff2') format('woff2');
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    padding: 20px;
    color: #000;
    background: #fff;
    font-family: 'Lato', Verdana, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }

  main {
    width: 100%;
    max-width: 800px;
    min-height: calc(100svh - 40px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    margin: 20px 0 44px;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
  }

  nav,
  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  nav {
    gap: 0;
    margin-bottom: 20px;
    font-size: 16px;
    font-weight: 700;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: #f09228;
  }

  .social-links {
    gap: 0;
    color: #777;
    font-size: 13px;
  }

  nav a,
  .social-links a {
    color: #1772d0;
  }

  nav a:hover,
  nav a:focus-visible,
  .social-links a:hover,
  .social-links a:focus-visible {
    color: #f09228;
  }

  nav a:not(:last-child)::after {
    content: '·';
    display: inline-block;
    margin: 0 20px;
    color: #bbb;
    font-weight: 400;
  }

  .social-links a:not(:last-child)::after {
    content: '/';
    display: inline-block;
    margin: 0 13px;
    color: #bbb;
  }

  footer {
    margin-top: 44px;
    color: #666;
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 480px) {
    :global(body) {
      padding: 16px;
    }

    main {
      width: 100%;
    }

    h1 {
      margin-bottom: 20px;
    }

    nav,
    .social-links {
      row-gap: 4px;
    }

    nav a:not(:last-child)::after {
      margin: 0 12px;
    }

    .social-links a:not(:last-child)::after {
      margin: 0 8px;
    }
  }
</style>
