---
import SiteFooter from '../components/SiteFooter.astro';
import { homeNavigation } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="home-shell">
    <header class="intro">
      <h1>Lyle Zheng</h1>

      <nav aria-label="Primary navigation">
        {
          homeNavigation.map((item) => (
            <a
              class:list={{ current: item.id === 'home' }}
              href={item.href}
              aria-current={item.id === 'home' ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <SiteFooter />
  </main>
</BaseLayout>

<style>
  .home-shell {
    width: 100%;
    max-width: 760px;
    min-height: calc(100svh - var(--page-viewport-offset));
    margin: 0 auto;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
  }

  .intro {
    grid-row: 2;
    width: 100%;
  }

  h1 {
    margin: 0 0 32px;
    font-size: 34px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    text-align: center;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
  }

  nav a {
    color: var(--color-link);
  }

  nav a.current {
    color: var(--color-text);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-accent);
  }

  nav a:not(:last-child)::after {
    content: '·';
    display: inline-block;
    margin: 0 20px;
    color: var(--color-separator);
    font-weight: 400;
  }

  .home-shell > :global(.site-footer) {
    grid-row: 3;
    align-self: end;
  }

  @media (max-width: 480px) {
    h1 {
      margin-bottom: 24px;
      font-size: 32px;
    }

    nav {
      row-gap: 4px;
    }

    nav a:not(:last-child)::after {
      margin: 0 12px;
    }
  }
</style>
