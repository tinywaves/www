---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lyle Zheng',
  description = "Lyle Zheng's personal website.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link
      rel="preload"
      href="/fonts/lato-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lato-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Lato';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url('/fonts/lato-400.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Lato';
    font-style: normal;
    font-weight: 700;
    font-display: block;
    src: url('/fonts/lato-700.woff2') format('woff2');
  }

  * {
    box-sizing: border-box;
  }

  body {
    --page-viewport-offset: 64px;

    min-width: 280px;
    margin: 0;
    padding: 32px;
    color: #000;
    background: #fff;
    font-family: 'Lato', Verdana, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: #f09228;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid #f09228;
    outline-offset: 3px;
  }

  @media (max-width: 480px) {
    body {
      --page-viewport-offset: 48px;

      padding: 24px 16px;
    }
  }
</style>
