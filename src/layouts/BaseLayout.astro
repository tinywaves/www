---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lyle Zheng',
  description = "Lyle Zheng's personal website.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link
      rel="preload"
      href="/fonts/lato-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lato-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = 'theme-preference';
        const validPreferences = ['light', 'dark', 'system'];
        let preference = 'system';

        try {
          const storedPreference = localStorage.getItem(storageKey);
          if (validPreferences.includes(storedPreference)) {
            preference = storedPreference;
          }
        } catch {}

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme =
          preference === 'system' ? (prefersDark ? 'dark' : 'light') : preference;

        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#161615' : '#ffffff');
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --color-background: #fff;
    --color-text: #000;
    --color-text-secondary: #444;
    --color-text-muted: #666;
    --color-text-subtle: #777;
    --color-border: #e4e4e4;
    --color-separator: #bbb;
    --color-surface-subtle: #f5f5f5;
    --color-link: #1772d0;
    --color-accent: #f09228;
    --color-tooltip-background: #333;
    --color-tooltip-text: #fff;
    --theme-switcher-background: #f5f5f5;
    --theme-switcher-border: #e4e4e4;
    --theme-switcher-active-background: #fff;
    --theme-switcher-active-text: #000;
    --theme-switcher-icon: #777;
    --theme-switcher-shadow: 0 1px 2px rgb(0 0 0 / 12%);
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --color-background: #161615;
    --color-text: #f2f0eb;
    --color-text-secondary: #c8c4bd;
    --color-text-muted: #a19d96;
    --color-text-subtle: #918d86;
    --color-border: #373532;
    --color-separator: #504d48;
    --color-surface-subtle: #232220;
    --color-link: #7db3ef;
    --color-accent: #f5a64f;
    --color-tooltip-background: #e9e6df;
    --color-tooltip-text: #1a1917;
    --theme-switcher-background: #211f1d;
    --theme-switcher-border: #393632;
    --theme-switcher-active-background: #393630;
    --theme-switcher-active-text: #f5f2ec;
    --theme-switcher-icon: #9e9991;
    --theme-switcher-shadow: 0 1px 2px rgb(0 0 0 / 35%);
  }

  @font-face {
    font-family: 'Lato';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url('/fonts/lato-400.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Lato';
    font-style: normal;
    font-weight: 700;
    font-display: block;
    src: url('/fonts/lato-700.woff2') format('woff2');
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--color-background);
  }

  body {
    --page-viewport-offset: 64px;

    min-width: 280px;
    min-height: 100svh;
    margin: 0;
    padding: 32px;
    color: var(--color-text);
    background: var(--color-background);
    font-family: 'Lato', Verdana, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-accent);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    body {
      transition: color 180ms ease, background-color 180ms ease;
    }
  }

  @media (max-width: 480px) {
    body {
      --page-viewport-offset: 48px;

      padding: 24px 16px;
    }
  }
</style>
